# Copy to apps/web/.env.local. Everything NEXT_PUBLIC_* is shipped to the browser.

# Solana RPC (devnet). A private RPC (Helius, Triton, QuickNode) is recommended for demos.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Public URL of the deployment, used for Blinks, Solana Pay QR codes and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SPL mint orders are priced in. Defaults to Circle's devnet USDC.
# For the demo, use the test mint printed by `pnpm bootstrap`.
NEXT_PUBLIC_PAYMENT_MINT=
NEXT_PUBLIC_PAYMENT_SYMBOL=USDC

# Demo mode (devnet only): burner wallets in the browser, a faucet, and a hosted demo arbiter.
NEXT_PUBLIC_DEMO=0
# Server-only. JSON byte arrays as written by `solana-keygen`. Never commit real values.
# Funder: pays faucet SOL and is the mint authority of the demo test token.
DEMO_FUNDER_SECRET=
# Arbiter: must match the arbiter in the on-chain config. Signs demo rulings.
DEMO_ARBITER_SECRET=
