{
  "name": "trustpay-escrow",
  "private": true,
  "description": "Buyer-protected escrow with disputes and on-chain vendor reputation for Instagram and WhatsApp sellers, on Solana.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:program": "bash scripts/build-program.sh",
    "dev": "pnpm --filter @trustpay/sdk build && pnpm --filter web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r test",
    "test:program": "cargo test --manifest-path programs/trustpay/Cargo.toml --lib && pnpm --filter @trustpay/sdk test:integration",
    "test:coverage": "pnpm --filter @trustpay/sdk test:coverage",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "deploy:devnet": "bash scripts/deploy-devnet.sh",
    "e2e": "bash scripts/e2e-local.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "tsx": "^4.23.15",
    "@trustpay/sdk": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "@solana/spl-token": "^0.4.14",
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.1"
  }
}
